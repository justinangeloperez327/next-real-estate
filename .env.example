# Prisma Postgres on Vercel Marketplace or another PostgreSQL server.
DATABASE_URL=
# Optional direct connection for Prisma migrations if DATABASE_URL is pooled.
DIRECT_DATABASE_URL=

# Optional Supabase Auth settings for sign-in and the admin dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Monthly importer only. Keep this key out of the public app.
REALTYAPI_KEY=

# Market shown when no location is searched (optional).
NEXT_PUBLIC_DEFAULT_LOCATION="Austin, TX"

# Mapbox public token (maps on listing pages): https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
