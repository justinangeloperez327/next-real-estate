# Supabase: Project settings > API (auth, contact messages, and listing reads)
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Monthly importer only. Keep both values out of the public app.
REALTYAPI_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Market shown when no location is searched (optional).
NEXT_PUBLIC_DEFAULT_LOCATION="Austin, TX"

# Mapbox public token (maps on listing pages): https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token
